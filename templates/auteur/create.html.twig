


{% extends "base.html.twig" %}
{% block title %} Page Auteur create {% endblock %}

{% block body %}
<style>
    .form-container {
        max-width: 550px;
        margin: 40px auto;
        padding: 32px;
        background: #ffffff;
        border-radius: 16px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.05);
        border: 1px solid #e2e8f0;
        font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }

    h1 {
        margin-top: 0;
        margin-bottom: 24px;
        color: #1e293b;
        font-size: 1.75rem;
        font-weight: 700;
        text-align: center;
    }

    /* Style des champs générés par Symfony */
    .form-container form div {
        margin-bottom: 18px;
    }

    .form-container label {
        display: block;
        margin-bottom: 6px;
        font-weight: 600;
        color: #475569;
        font-size: 0.95rem;
    }

    .form-container input[type="text"],
    .form-container input[type="email"],
    .form-container textarea,
    .form-container select {
        width: 100%;
        padding: 10px 14px;
        border: 1.5px solid #cbd5e1;
        border-radius: 8px;
        font-size: 1rem;
        color: #0f172a;
        background-color: #f8fafc;
        box-sizing: border-box;
        transition: border-color 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
    }

    .form-container input:focus,
    .form-container textarea:focus,
    .form-container select:focus {
        outline: none;
        border-color: #16a34a;
        background-color: #ffffff;
        box-shadow: 0 0 0 4px rgba(22, 163, 74, 0.15);
    }

    /* Bouton d'enregistrement */
    .btn-submit {
        width: 100%;
        margin-top: 10px;
        padding: 12px 20px;
        background-color: #16a34a;
        color: #ffffff;
        border: none;
        border-radius: 8px;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: background-color 0.2s ease, transform 0.1s ease;
    }

    .btn-submit:hover {
        background-color: #15803d;
    }

    .btn-submit:active {
        transform: scale(0.99);
    }

    /* Gestion des erreurs */
    .form-error, .form-container ul li {
        color: #dc2626;
        font-size: 0.875rem;
        margin-top: 4px;
    }

    /* Menu de navigation */
    .nav-links {
        display: flex;
        justify-content: center;
        gap: 12px;
        list-style: none;
        padding: 0;
        margin-top: 30px;
        flex-wrap: wrap;
    }

    .nav-links a {
        display: inline-block;
        padding: 8px 16px;
        background-color: #f1f5f9;
        color: #334155;
        text-decoration: none;
        border-radius: 8px;
        font-size: 0.9rem;
        font-weight: 500;
        transition: background-color 0.2s ease, color 0.2s ease;
    }

    .nav-links a:hover {
        background-color: #e2e8f0;
        color: #0f172a;
    }
</style>

<div class="form-container">
    <h1>Nouveau Auteur</h1>

    {{ form_start(form) }}
        {{ form_errors(form) }}
        {{ form_widget(form) }}

        <button type="submit" class="btn-submit">Enregistrer</button> 
    {{ form_end(form) }}

    <ul class="nav-links">
        <li><a href="{{ path('app_auteur_liste') }}">Liste des auteurs</a></li>
        <li><a href="{{ path('app_livre_create') }}">Ajouter un livre</a></li>
        <li><a href="{{ path('app_livre') }}">Liste des livres</a></li>
    </ul>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
    console.log('hello auteur');
</script>
{% endblock %}