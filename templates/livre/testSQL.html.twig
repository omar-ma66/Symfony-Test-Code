{# templates/livre/testSql.html.twig #}
{% extends 'base.html.twig' %}

{% block body %}
    <h1>Liste des livres (ID supérieur à {{ id }})</h1>

    {% if resultat is not empty %}
        <ul>
            {% for livre in resultat %}
                <li>
                    {# Accès aux colonnes par leur nom en base de données #}
                    <strong>{{ livre.titre }}</strong> - ID: {{ livre.id }}
                </li>
            {% endfor %}
        </ul>
    {% else %}
        <p>Aucun livre trouvé avec un ID supérieur à {{ id }}.</p>
    {% endif %}
      <h2>Liste des livres depuis EMI avec ID 3</h2>
                {% if livre is not empty %}
                 <p>il y a {{ livre | length }} livre </p>
                    <p> {{livre.titre }} </p>
                    <p> {{livre.date | date('d/m/Y') }} </p>
                    <p> {{livre.prix  }} </p>
                    <p> {{livre.categorie  }} </p>
                {% else %}
                    <p> la variable est vide </p>    
                {% endif %}

                   {% if auteur is not empty %}
                   {{ dump(auteur) }}
                 <p>il y a {{ auteur | length }} livre </p>
                    <p> {{auteur.nom }}  {{auteur.prenom }}</p>

                            {%  set books = auteur.livres %}

                            {% for book in books %}
                             <p> {{ book.titre }} </p>
                             <p> {{ book.date|date('d/m/Y') }} </p>
                             <p> {{ book.prix }} </p>
                             <p> {{ book.categorie }} </p>
                             {% endfor %}
                {% else %}
                    <p> la variable est vide </p>    
                {% endif %}


{% endblock %}