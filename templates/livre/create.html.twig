{% extends "base.html.twig" %}
{% block title %} Page create livres {% endblock %}


        {% block body %}
<style>
        h1{
            color:white ;
            background-color : black ;
            padding:20px ;
            text-align:center;
        }
        .boite{
            width: 300px ;
            margin:0 auto ;
            border-radius:10px;
            border:1px solid black ;
            text-align:center;
            display:flex;
            flex-direction :column;
            gap :10px ;

        }
        .btn-submit{
                align-self:flex-start; 
        }
        p{
            color :green ;
        }
        span{
            font-weight :bold;
            font-size: 16px;
            color:black;
        }
        .monlien{
            display:flex;
            flex-direction:row ;
            flex-wrap:nowrap;
            justify-content:flex-end;
        }
        ul{
            list-style-type:none;
        }
        a{
            display:inline-block;
            padding:10px;
            text-decoration:none;
            background-color :green;
            color:white;
            border-radius:10px ;
        }
    </style>
                            <h1> creation d'un nouveau livre </h1>
 
                            {{ form_start (form) }} 
                               
<div class="boite">
                        <div>
                                {{ form_label(form.titre) }}
                                {{ form_widget(form.titre) }}
                                {{ form_errors(form.titre) }}
                        </div>
                        <div>
                                {{ form_label(form.date) }}
                                {{ form_widget(form.date) }}
                                {{ form_errors(form.date) }}
                        </div>
                           <div>
                                {{ form_label(form.prix) }}
                                {{ form_widget(form.prix) }}
                                {{ form_errors(form.prix) }} 
                        </div>
                         <div>
                                {{ form_label(form.categorie) }}
                                {{ form_widget(form.categorie) }}
                                {{ form_errors(form.categorie) }} 
                        </div>
                           <div>
                                {{ form_label(form.auteur) }}
                                {{ form_widget(form.auteur) }}
                                {{ form_errors(form.auteur) }} 
                          </div>

                                       <button class ="btn-submit" type="submit" >Enregistrer</button>
</div>
                            {{ form_end (form) }}

                            
 
 <a href="{{ path('app_livre') }}" >Retour a l'acceuil</a>
        {% endblock %}

      
        