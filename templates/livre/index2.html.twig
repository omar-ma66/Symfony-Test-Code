 {% extends "base.html.twig" %}

{% block title %} Page index 2 html twig {% endblock %}

{% block body %}
<style>
table {
    width: 100%;
    max-width: 600px;
    margin: 20px auto;
    text-align: center;
    font-size: 110%;
    border-collapse: collapse;
}

th, td {
    padding: 12px 8px;
    border-bottom: 1px solid #e2e8f0;
}

th {
    background-color: #f8fafc;
    font-weight: bold;
}

ul {
    display: flex;
    list-style-type: none;
    justify-content: flex-end;
    padding: 0;
}

a {
    display: inline-block;
    padding: 10px 16px;
    background-color: green;
    color: white;
    text-decoration: none;
    border-radius: 10px;
}

.btn-delete {
    background-color: #ef4444;
    color: #ffffff;
    font-weight: 600;
    font-size: 14px;
    padding: 8px 16px;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    box-shadow: 0 2px 4px rgba(239, 68, 68, 0.2);
    transition: background-color 0.2s ease, transform 0.1s ease, box-shadow 0.2s ease;
}

.btn-delete:hover {
    background-color: #dc2626;
    box-shadow: 0 4px 6px rgba(239, 68, 68, 0.3);
}

.btn-delete:active {
    transform: scale(0.97);
}
</style>



{% if livres|length > 0 %}
    <p style="text-align: center; font-weight: bold;">
        Nombre de livre(s) : {{ livres|length }}
    </p>

    <table>
        <thead>
            <tr>
                <th>Titre</th>
                <th>Date</th>  
                <th>Auteur</th>
                <th>Action</th>
                <th>Edite</th>
              
            </tr>
        </thead>
        <tbody>
            {% for livre in livres %}
                <tr>
                    <td>{{ livre.titre }}</td>
                    <td>{{ livre.date|date('d/m/Y') }}</td>
                    <td>{{livre.auteur.nom }} {{ livre.auteur.prenom }}</td>
                    <td>
                        <form method="POST" action="{{ path('app_livre_delete', { id: livre.id }) }}" onsubmit="return confirm('Es-tu sûr de vouloir le supprimer ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ livre.id) }}">
                            <button class="btn-delete" type="submit">Supprimer</button>
                        </form>
                    </td>
                    <td>
                        <a href="{{ path('app_livre_update',{id: livre.id}) }}">Edite</a>
                    </td>
                    
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% else %}
    <p style="text-align: center;">Aucun livre disponible pour le moment.</p>
{% endif %}

<ul>
    <li>
        <a href="{{ path('app_livre_create') }}">Ajouter un livre</a>
    </li>
</ul>


{% endblock %}