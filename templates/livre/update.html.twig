{% extends "base.html.twig" %}

{% block title %}Modifier le Livre{% endblock %}

{% block body %}
<style>
    .form-container {
        max-width: 600px;
        margin: 40px auto;
        padding: 32px;
        background: #ffffff;
        border-radius: 16px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.05);
        border: 1px solid #e2e8f0;
        font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }

    .form-header {
        text-align: center;
        margin-bottom: 28px;
    }

    .form-header h1 {
        margin: 0 0 8px 0;
        color: #0f172a;
        font-size: 1.75rem;
        font-weight: 700;
    }

    .form-header p {
        margin: 0;
        color: #64748b;
        font-size: 0.9rem;
    }

    .route-info {
        display: inline-block;
        background-color: #f1f5f9;
        color: #475569;
        font-size: 0.8rem;
        padding: 4px 10px;
        border-radius: 6px;
        margin-top: 8px;
        font-family: monospace;
    }

    /* Organisation des champs du formulaire */
    .form-group {
        display: flex;
        flex-direction: column;
        margin-bottom: 20px;
    }

    .form-group label {
        margin-bottom: 6px;
        font-weight: 600;
        color: #475569;
        font-size: 0.95rem;
    }

    .form-group input, 
    .form-group select, 
    .form-group textarea {
        width: 100%;
        padding: 10px 14px;
        border: 1.5px solid #cbd5e1;
        border-radius: 8px;
        font-size: 1rem;
        color: #0f172a;
        background-color: #f8fafc;
        box-sizing: border-box;
        transition: border-color 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
    }

    .form-group input:focus, 
    .form-group select:focus, 
    .form-group textarea:focus {
        outline: none;
        border-color: #16a34a;
        background-color: #ffffff;
        box-shadow: 0 0 0 4px rgba(22, 163, 74, 0.15);
    }

    /* Message d'erreur */
    .form-error {
        color: #dc2626;
        font-size: 0.875rem;
        margin-top: 6px;
        font-weight: 500;
    }

    /* Bouton principal */
    .btn-submit {
        width: 100%;
        margin-top: 10px;
        padding: 12px 20px;
        background-color: #16a34a;
        color: #ffffff;
        border: none;
        border-radius: 8px;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: background-color 0.2s ease, transform 0.1s ease;
    }

    .btn-submit:hover {
        background-color: #15803d;
    }

    .btn-submit:active {
        transform: scale(0.99);
    }

    /* Navigation inférieure */
    .nav-links {
        display: flex;
        justify-content: center;
        gap: 12px;
        list-style: none;
        padding: 0;
        margin-top: 28px;
    }

    .nav-links a {
        display: inline-block;
        padding: 8px 16px;
        background-color: #f1f5f9;
        color: #334155;
        text-decoration: none;
        border-radius: 8px;
        font-size: 0.9rem;
        font-weight: 500;
        transition: background-color 0.2s ease, color 0.2s ease;
    }

    .nav-links a:hover {
        background-color: #e2e8f0;
        color: #0f172a;
    }
</style>

<div class="form-container">
    <div class="form-header">
        <h1>Modifier le Livre</h1>
        {% if app.current_route == 'app_livre_update' %}
            <span class="route-info">Route : {{ app.current_route }}</span>
        {% endif %}
    </div>

    {{ form_start(form) }}
        {{ form_errors(form) }}

        <div class="form-group">
            {{ form_label(form.titre, 'Titre du livre') }}
            {{ form_widget(form.titre) }}
            <div class="form-error">{{ form_errors(form.titre) }}</div>
        </div>    

        <div class="form-group">
            {{ form_label(form.date, 'Date de parution') }}
            {{ form_widget(form.date) }}
            <div class="form-error">{{ form_errors(form.date) }}</div>
        </div>

        <div class="form-group">
            {{ form_label(form.prix, 'Prix du livre (€)') }}
            {{ form_widget(form.prix) }}
            <div class="form-error">{{ form_errors(form.prix) }}</div>
        </div>

        <div class="form-group">
            {{ form_label(form.auteur, "Nom de l'auteur") }}
            {{ form_widget(form.auteur) }}
            <div class="form-error">{{ form_errors(form.auteur) }}</div>
        </div>

        {{ form_rest(form) }}

        <button type="submit" class="btn-submit">Mettre à jour</button>
    {{ form_end(form, {'render_rest': false}) }}

    <ul class="nav-links">
        <li><a href="{{ path('app_livre') }}">← Retour au catalogue</a></li>
        <li><a href="{{ path('app_auteur_liste') }}">Liste des auteurs</a></li>
    </ul>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        console.log("Formulaire d'édition chargé.");
    </script>
{% endblock %}