{% extends 'base.html.twig' %}

{% block title %}Accès refusé (403){% endblock %}

{% block body %}
<style>
    .error-container {
        max-width: 520px;
        margin: 80px auto;
        padding: 40px;
        background: #ffffff;
        border-radius: 16px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.05);
        border: 1px solid #e2e8f0;
        font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        text-align: center;
    }

    .error-icon {
        width: 72px;
        height: 72px;
        background-color: #fef2f2;
        color: #dc2626;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 24px;
    }

    .error-code {
        font-size: 0.875rem;
        font-weight: 700;
        color: #dc2626;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 8px;
    }

    .error-title {
        margin: 0 0 12px 0;
        color: #0f172a;
        font-size: 1.75rem;
        font-weight: 700;
    }

    .error-message {
        margin: 0 0 32px 0;
        color: #64748b;
        font-size: 0.975rem;
        line-height: 1.6;
    }

    .actions-group {
        display: flex;
        justify-content: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .btn-action {
        display: inline-block;
        padding: 12px 20px;
        border-radius: 8px;
        font-size: 0.95rem;
        font-weight: 600;
        text-decoration: none;
        transition: background-color 0.2s ease, transform 0.1s ease;
    }

    .btn-primary {
        background-color: #16a34a;
        color: #ffffff;
    }

    .btn-primary:hover {
        background-color: #15803d;
    }

    .btn-secondary {
        background-color: #f1f5f9;
        color: #334155;
    }

    .btn-secondary:hover {
        background-color: #e2e8f0;
        color: #0f172a;
    }

    .btn-action:active {
        transform: scale(0.99);
    }
</style>

<div class="error-container">
    <div class="error-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m0 0h.01M12 9v2m-6.364 8.364A9 9 0 1118.364 5.636 9 9 0 015.636 18.364z" />
        </svg>
    </div>

    <div class="error-code">Erreur 403</div>
    <h1 class="error-title">Accès non autorisé</h1>
    <p class="error-message">
        Désolé, vous n'avez pas les permissions nécessaires (rôle requis) pour accéder à cette page ou effectuer cette action.
    </p>

    <div class="actions-group">
        <a href="{{ path('app_home') }}" class="btn-action btn-primary">Retour à l'accueil</a>
        
        {% if app.user %}
            <a href="{{ path('app_logout') }}" class="btn-action btn-secondary">Changer de compte</a>
        {% else %}
            <a href="{{ path('app_login') }}" class="btn-action btn-secondary">Se connecter</a>
        {% endif %}
    </div>
</div>
{% endblock %}