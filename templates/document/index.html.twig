
{% extends 'base.html.twig' %}

{% block title %}Mes documents PDF{% endblock %}

{% block body %}

<style>

    .documents-container {
        max-width: 900px;
        margin: 60px auto;
        padding: 0 20px;
    }

    .documents-header {
        margin-bottom: 30px;
    }

    .documents-header h1 {
        margin-bottom: 8px;
        font-size: 32px;
        color: #222;
    }

    .documents-header p {
        color: #777;
        margin: 0;
    }

    .documents-count {
        display: inline-block;
        margin-top: 15px;
        padding: 7px 14px;
        border-radius: 20px;
        background: #f1f3f5;
        color: #555;
        font-size: 14px;
    }

    .documents-list {
        display: flex;
        flex-direction: column;
        gap: 15px;
    }

    .document-card {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 20px;
        background: white;
        border: 1px solid #e5e5e5;
        border-radius: 12px;
        box-shadow: 0 3px 10px rgba(0, 0, 0, 0.05);
        transition: all 0.2s ease;
    }

    .document-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 7px 18px rgba(0, 0, 0, 0.10);
        border-color: #d0d0d0;
    }

    .document-info {
        display: flex;
        align-items: center;
        gap: 15px;
        min-width: 0;
    }

    .pdf-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 48px;
        height: 48px;
        flex-shrink: 0;
        border-radius: 10px;
        background: #fce8e8;
        color: #d93025;
        font-weight: bold;
        font-size: 14px;
    }

    .document-name {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-weight: 600;
        color: #333;
    }

    .document-button {
        flex-shrink: 0;
        padding: 9px 16px;
        border-radius: 8px;
        background: #222;
        color: white;
        text-decoration: none;
        font-size: 14px;
        transition: background 0.2s ease;
    }

    .document-button:hover {
        background: #444;
    }

    .empty-message {
        padding: 50px 20px;
        text-align: center;
        background: #f8f9fa;
        border: 1px dashed #ccc;
        border-radius: 12px;
        color: #777;
    }

</style>


<div class="documents-container">

    <div class="documents-header">

        <h1>Mes documents</h1>

        {% if pdf_file is not null %}

            <p>Voici les fichiers PDF disponibles.</p>

            <span class="documents-count">
                {{ pdf_file|length }} fichier(s)
            </span>

        {% endif %}

    </div>


    {% if pdf_file is not null and pdf_file|length > 0 %}

        <div class="documents-list">

            {% for file in pdf_file %}

                <div class="document-card">

                    <div class="document-info">

                        <div class="pdf-icon">
                            PDF
                        </div>

                        <span class="document-name">
                            {{ file }}
                        </span>

                    </div>

                    <a
                        target="_blank"
                        href="{{ asset('uploads/brochures/' ~ file) }}"
                        class="document-button"
                    >
                        Ouvrir
                    </a>

                </div>

            {% endfor %}

        </div>

    {% else %}

        <div class="empty-message">
            <p>📂</p>
            <strong>Aucun fichier PDF</strong>
            <p>Il n'y a actuellement aucun document dans le dossier.</p>
        </div>

    {% endif %}

</div>

{% endblock %}
